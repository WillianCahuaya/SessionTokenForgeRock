                  "const amadmin_password = \"9HKHQeCZNBL8GEx7qwkmrCpq\";\r",
                  "\r",
                  "\r",
                  "postman.setEnvironmentVariable(\"ENV\", ENV);\r",
                  "postman.setEnvironmentVariable(\"am_url\", am_url);\r",
                  "postman.setEnvironmentVariable(\"ig_url\", ig_url);\r",
                  "postman.setEnvironmentVariable(\"client_id\", client_id);\r",
                  "postman.setEnvironmentVariable(\"client_secret\", client_secret);\r",
                  "postman.setEnvironmentVariable(\"username\", username);\r",
                  "postman.setEnvironmentVariable(\"password\", password);\r",
                  "postman.setEnvironmentVariable(\"tokenA\", tokenA);\r",
                  "postman.setEnvironmentVariable(\"amadmin_password\", amadmin_password);\r",
