{
    "properties": {
        "amUsername": "testuser",
        "amPassword": "Password123!",
        "companyIgAgentUsername": "company-ig-agent",

        "sessionApiBaseUrl": "http://localhost:8081/kube",
        "idcBaseUrl": "http://am.forgerock.svc.cluster.local/am",

        "revocationClientId": "ig-session-revoker",
        "revocationClientSecret": "adminoauth",

        "ciamSubscriptionKey": "123456789012345678901234567890123",

        "introspectionClientId": "mobile-simulator",
        "introspectionClientSecret": "mobile-secret"
    },
    "globalDecorator": {
        "timer": true,
        "capture": "all"
    },
    "handler": {
        "type": "DispatchHandler",
        "config": {
            "bindings": [
                {
                    "condition": "${request.uri.host == env['MY_POD_IP']}",
                    "handler": {
                        "name": "router-pod",
                        "type": "Router",
                        "config": {
                            "scanInterval": "disabled",
                            "directory": "${openig.configDirectory}/routes-pod"
                        }
                    }
                },
                {
                    "condition": "${request.uri.host != env['MY_POD_IP']}",
                    "handler": {
                        "name": "router-service",
                        "type": "Router",
                        "config": {
                            "scanInterval": "disabled",
                            "directory": "${openig.configDirectory}/routes-service"
                        }
                    }
                }
            ]
        }
    },
    "heap": [
        {
            "name": "JwtSession",
            "type": "JwtSession"
        },
        {
            "name": "company-am-service",
            "type": "AmService",
            "config": {
                "url": "http://am/am",
                "realm": "/",
                "version": "7.1",
                "agent": {
                    "username": "${companyIgAgentUsername}",
                    "passwordSecretId": "company-ig-agent.password"
                },
                "secretsProvider": "amSecretsProvider",
                "sessionCache": {
                    "enabled": false
                },
                "sessionIdleRefresh": {
                    "enabled": true,
                    "interval": "3 m"
                }
            }
        },
        {
            "name": "Authenticate to AM Chain",
            "type": "Chain",
            "config": {
                "handler": "ClientHandler",
                "filters": ["Authenticate to AM Filter"]
            }
        },
        {
            "name": "Authenticate to AM Filter",
            "type": "HeaderFilter",
            "config": {
                "messageType": "REQUEST",
                "add": {
                    "Authorization": [
                        "Basic ${encodeBase64(join(array(introspectionClientId, introspectionClientSecret), ':'))}"
                    ]
                }
            }
        },
        {
            "name": "company-token-introspection",
            "type": "TokenIntrospectionAccessTokenResolver",
            "config": {
                "amService": "company-am-service",
                "providerHandler": "Authenticate to AM Chain"
            }
        },
        {
            "name": "company-cache-access-token",
            "type": "CacheAccessTokenResolver",
            "config": {
                "enabled": true,
                "defaultTimeout": "1 hour",
                "maximumTimeToCache": "1 hour",
                "delegate": "company-token-introspection",
                "amService": "company-am-service"
            }
        },
        {
            "name": "company-security-headers",
            "type": "ScriptableFilter",
            "config": {
                "type": "application/x-groovy",
                "file": "SecurityHeaders.groovy"
            }
        },
        {
            "name": "company-conditional-integration-session",
            "type": "ConditionalFilter",
            "config": {
                "condition": "${not find(request.uri.path, '/delete')}",
                "delegate": "company-get-session-info"
            }
        },
        {
            "name": "company-Oauth-integration-session",
            "type": "OAuth2ResourceServerFilter",
            "config": {
                "requireHttps": false,
                "scopes": ["IG:Integration Session"],
                "accessTokenResolver": "company-cache-access-token"
            }
        },
        {
            "name": "AmService-1",
            "type": "AmService",
            "config": {
                "url": "http://am/am",
                "realm": "/",
                "secretsProvider": "amSecretsProvider",
                "agent": {
                    "username": "ig-agent",
                    "passwordSecretId": "agent.password"
                },
                "sessionCache": {
                    "enabled": true
                }
            }
        },
        {
            "name": "ForgeRockClientHandler",
            "type": "ClientHandler",
            "config": {
                "trustManager": {
                    "type": "TrustAllManager"
                }
            },
            "_capture": "all"
        },
        {
            "name": "amSecretsProvider",
            "type": "SecretsProvider",
            "config": {
                "stores": [
                    {
                        "type": "Base64EncodedSecretStore",
                        "config": {
                            "_comment": "base64('password') = 'cGFzc3dvcmQ='",
                            "secrets": {
                                "agent.password": "cGFzc3dvcmQ=",
                                "company-ig-agent.password": "YWRtaW5pZw=="
                            }
                        }
                    }
                ]
            }
        },
        {
            "name": "pemPropertyFormat",
            "type": "PemPropertyFormat"
        },
        {
            "type": "SecretsProvider",
            "name": "tokenBSecretsProvider",
            "config": {
                "stores": [
                    {
                        "type": "FileSystemSecretStore",
                        "config": {
                            "directory": "/var/ig/secrets",
                            "format": "PLAIN",
                            "suffix": ".pem",
                            "mappings": [
                                {
                                    "secretId": "tokenBSigningKey",
                                    "format": "pemPropertyFormat"
                                }
                            ]
                        }
                    }
                ]
            }
        }
    ],
    "monitor": true
}
