{
    "name": "16a-apis-integration-token-jwt",
    "condition": "${find(request.uri.path, '^/integration-token/jwt')}",
    "baseURI": "${sessionApiBaseUrl}",
    "handler": {
        "type": "Chain",
        "config": {
            "filters": [
                {
                    "name": "company-Oauth-integration-token",
                    "type": "OAuth2ResourceServerFilter",
                    "config": {
                        "requireHttps": false,
                        "scopes": ["IG:Integration"],
                        "accessTokenResolver": "company-cache-access-token"
                    }
                },
                {
                    "type": "UriPathRewriteFilter",
                    "config": {
                        "mappings": {
                            "/integration-token/jwt": "/"
                        }
                    }
                },
                {
                    "name": "company-integration-token",
                    "type": "ScriptableFilter",
                    "config": {
                        "type": "application/x-groovy",
                        "file": "InternalToken.groovy"
                    }
                }
            ],
            "handler": {
                "type": "ReverseProxyHandler",
                "config": {
                    "tls": {
                        "type": "ClientTlsOptions",
                        "config": {
                            "trustManager": {
                                "type": "TrustAllManager"
                            }
                        }
                    },
                    "hostnameVerifier": "ALLOW_ALL"
                }
            }
        }
    }
}
